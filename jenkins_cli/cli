#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

if [ -f "${REPO_ROOT}/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "${REPO_ROOT}/.env"
  set +a
fi

require_env() {
  var_name="$1"
  eval "var_value=\${$var_name-}"
  if [ -z "${var_value}" ]; then
    echo "Missing required environment variable: ${var_name}" >&2
    exit 1
  fi
}

require_env "JENKINS_URL"
require_env "JENKINS_USER"
require_env "JENKINS_TOKEN"

JAR_PATH="${JENKINS_CLI_JAR:-${SCRIPT_DIR}/jenkins-cli.jar}"
JAR_PATH="${JENKINS_CLI_JAR:-/tmp/jenkins-cli.jar}"

if [ ! -f "${JAR_PATH}" ]; then
  mkdir -p "$(dirname "${JAR_PATH}")"
  curl -fsSLo "${JAR_PATH}" "${JENKINS_URL%/}/jnlpJars/jenkins-cli.jar"
fi

exec java -jar "${JAR_PATH}" \
  -s "${JENKINS_URL}" \
  -auth "${JENKINS_USER}:${JENKINS_TOKEN}" \
  "$@"
