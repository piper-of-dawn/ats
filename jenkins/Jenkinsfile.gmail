pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        cron('TZ=Europe/Berlin\n0 7 * * *')
    }

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'ats', description: 'Local Docker image name on the Jenkins server.')
        string(name: 'APP_ENV_FILE', defaultValue: '/var/lib/jenkins/ats/app.env', description: 'Runtime env file passed into docker run for DB access.')
        string(name: 'GMAIL_RUNTIME_DIR', defaultValue: '/var/lib/jenkins/ats-gmail', description: 'Persistent host directory for Gmail output, token, and generated env file.')
        string(name: 'CONTAINER_NAME_PREFIX', defaultValue: 'ats-gmail', description: 'Prefix used for the transient docker container name.')
        string(name: 'GMAIL_CLIENT_SECRET_CREDENTIAL_ID', defaultValue: 'gmail-oauth-client-secret', description: 'Jenkins Secret file credential ID for the Google Desktop OAuth client JSON.')
        string(name: 'GMAIL_TOKEN_BOOTSTRAP_CREDENTIAL_ID', defaultValue: '', description: 'Optional Jenkins Secret file credential ID for an initial token.json bootstrap. Used only when the runtime token file does not exist yet.')
        string(name: 'GMAIL_QUERY', defaultValue: 'from:(trading212.com) (subject:"statement" OR subject:"account statement" OR subject:"Trading 212") has:attachment filename:pdf', description: 'Gmail search query used by gmail-downloader.')
        string(name: 'MAX_RESULTS', defaultValue: '200', description: 'Maximum Gmail messages to inspect per run.')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Preview matches without downloading PDFs or writing to the database.')
    }

    stages {
        stage('Verify Tooling') {
            steps {
                sh 'docker --version'
                sh 'docker info >/dev/null'
            }
        }

        stage('Verify Image And Env') {
            steps {
                sh '''
                    set -euo pipefail
                    test -f "${APP_ENV_FILE}"
                    docker image inspect "${IMAGE_NAME}:latest" >/dev/null
                '''
            }
        }

        stage('Prepare Gmail Runtime') {
            steps {
                script {
                    def bindings = [
                        file(credentialsId: params.GMAIL_CLIENT_SECRET_CREDENTIAL_ID, variable: 'GMAIL_CLIENT_SECRET_FILE'),
                    ]
                    if (params.GMAIL_TOKEN_BOOTSTRAP_CREDENTIAL_ID?.trim()) {
                        bindings << file(
                            credentialsId: params.GMAIL_TOKEN_BOOTSTRAP_CREDENTIAL_ID.trim(),
                            variable: 'GMAIL_TOKEN_BOOTSTRAP_FILE',
                        )
                    }

                    withCredentials(bindings) {
                        sh '''
                            set -euo pipefail
                            runtime_dir="${GMAIL_RUNTIME_DIR}"
                            mkdir -p "${runtime_dir}/config" "${runtime_dir}/output" "${runtime_dir}/secrets"
                            install -m 600 "${GMAIL_CLIENT_SECRET_FILE}" "${runtime_dir}/secrets/secret.json"

                            if [ ! -f "${runtime_dir}/config/token.json" ] && [ -n "${GMAIL_TOKEN_BOOTSTRAP_FILE:-}" ]; then
                                install -m 600 "${GMAIL_TOKEN_BOOTSTRAP_FILE}" "${runtime_dir}/config/token.json"
                            fi

                            if [ ! -f "${runtime_dir}/config/token.json" ]; then
                                echo "Missing ${runtime_dir}/config/token.json. Provide GMAIL_TOKEN_BOOTSTRAP_CREDENTIAL_ID for the first run." >&2
                                exit 1
                            fi

                            cat > "${runtime_dir}/gmail.env" <<EOF
GMAIL_QUERY=${GMAIL_QUERY}
OUTPUT_DIR=/app/output
OAUTH_CLIENT_SECRET_FILE=/app/secrets/secret.json
TOKEN_FILE=/app/config/token.json
STATE_FILE=/app/output/.state.json
MAX_RESULTS=${MAX_RESULTS}
DRY_RUN=$([ "${DRY_RUN}" = "true" ] && printf '1' || printf '0')
EOF

                            chmod 600 "${runtime_dir}/gmail.env"
                        '''
                    }
                }
            }
        }

        stage('Run Gmail Sync') {
            steps {
                sh '''
                    set -euo pipefail
                    container_name="${CONTAINER_NAME_PREFIX}-${BUILD_NUMBER}"

                    docker run --rm \
                        --name "${container_name}" \
                        --env-file "${APP_ENV_FILE}" \
                        --env-file "${GMAIL_RUNTIME_DIR}/gmail.env" \
                        -v "${GMAIL_RUNTIME_DIR}/output:/app/output" \
                        -v "${GMAIL_RUNTIME_DIR}/config:/app/config" \
                        -v "${GMAIL_RUNTIME_DIR}/secrets:/app/secrets:ro" \
                        --entrypoint trading212-gmail-sync && announce-fund-nav \
                        "${IMAGE_NAME}:latest"
                '''
            }
        }
    }

    post {
        success {
            echo "Completed Gmail statement sync at 07:00 Europe/Berlin using ${params.IMAGE_NAME}:latest."
        }
    }
}
