pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run pytest before building the image.')
        booleanParam(name: 'FORCE_REBUILD', defaultValue: false, description: 'Build even when the current main commit matches the last built commit.')
        string(name: 'BUILD_BRANCH', defaultValue: 'main', description: 'Only this branch is allowed to build the local Docker image.')
        string(name: 'IMAGE_NAME', defaultValue: 'ats', description: 'Local Docker image name on the Jenkins server.')
        string(name: 'BUILD_STATE_DIR', defaultValue: '/var/lib/jenkins/ats-build', description: 'Directory used to persist the last successfully built commit SHA.')
        booleanParam(name: 'PRUNE_IMAGES', defaultValue: true, description: 'Prune dangling Docker images and build cache after a successful rebuild.')
    }

    environment {
        REBUILD_REQUIRED = 'false'
        CURRENT_COMMIT = ''
        LAST_BUILT_COMMIT = ''
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tooling') {
            steps {
                sh 'uv --version'
                sh 'just --version'
                sh 'docker --version'
                sh 'docker info >/dev/null'
            }
        }

        stage('Check Main Commit') {
            when {
                expression { return env.BRANCH_NAME == params.BUILD_BRANCH }
            }
            steps {
                script {
                    env.CURRENT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    sh 'mkdir -p "${BUILD_STATE_DIR}"'
                    def stampFile = "${params.BUILD_STATE_DIR}/${params.IMAGE_NAME}.last_built_commit"
                    env.LAST_BUILT_COMMIT = sh(
                        script: "[ -f '${stampFile}' ] && cat '${stampFile}' || true",
                        returnStdout: true,
                    ).trim()

                    def rebuildRequired = params.FORCE_REBUILD || !env.LAST_BUILT_COMMIT || env.CURRENT_COMMIT != env.LAST_BUILT_COMMIT
                    env.REBUILD_REQUIRED = rebuildRequired ? 'true' : 'false'

                    if (rebuildRequired) {
                        echo "Rebuild required for commit ${env.CURRENT_COMMIT} (previous built commit: ${env.LAST_BUILT_COMMIT ?: 'none'})."
                    } else {
                        echo "Skipping rebuild because commit ${env.CURRENT_COMMIT} is already built."
                    }
                }
            }
        }

        stage('Build Wheel') {
            when {
                allOf {
                    expression { return env.BRANCH_NAME == params.BUILD_BRANCH }
                    expression { return env.REBUILD_REQUIRED == 'true' }
                }
            }
            steps {
                sh 'rm -rf dist'
                sh 'just build'
                sh 'ls -lh dist'
            }
        }

        stage('Test') {
            when {
                allOf {
                    expression { return params.RUN_TESTS }
                    expression { return env.BRANCH_NAME == params.BUILD_BRANCH }
                    expression { return env.REBUILD_REQUIRED == 'true' }
                }
            }
            steps {
                sh 'uv run pytest -q'
            }
        }

        stage('Build Image') {
            when {
                allOf {
                    expression { return env.BRANCH_NAME == params.BUILD_BRANCH }
                    expression { return env.REBUILD_REQUIRED == 'true' }
                }
            }
            steps {
                sh '''
                    set -euo pipefail
                    docker build --tag "${IMAGE_NAME}:latest" .
                '''
            }
        }

        stage('Record Built Commit') {
            when {
                allOf {
                    expression { return env.BRANCH_NAME == params.BUILD_BRANCH }
                    expression { return env.REBUILD_REQUIRED == 'true' }
                }
            }
            steps {
                sh '''
                    set -euo pipefail
                    mkdir -p "${BUILD_STATE_DIR}"
                    printf '%s\n' "${CURRENT_COMMIT}" > "${BUILD_STATE_DIR}/${IMAGE_NAME}.last_built_commit"
                '''
            }
        }

        stage('Prune Docker') {
            when {
                allOf {
                    expression { return params.PRUNE_IMAGES }
                    expression { return env.BRANCH_NAME == params.BUILD_BRANCH }
                    expression { return env.REBUILD_REQUIRED == 'true' }
                }
            }
            steps {
                sh '''
                    set -euo pipefail
                    docker image prune -f
                    docker builder prune -f
                '''
            }
        }
    }

    post {
        success {
            script {
                if (env.BRANCH_NAME != params.BUILD_BRANCH) {
                    echo "Build job is idle because branch ${env.BRANCH_NAME} is not ${params.BUILD_BRANCH}."
                } else if (env.REBUILD_REQUIRED == 'true') {
                    echo "Built ${params.IMAGE_NAME}:latest from commit ${env.CURRENT_COMMIT}."
                } else {
                    echo "No new commit on ${params.BUILD_BRANCH}; image rebuild skipped."
                }
            }
        }
    }
}
