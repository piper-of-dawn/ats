pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    triggers {
        cron('TZ=Europe/Berlin\n0 8 * * *')
    }
    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'ats', description: 'Local Docker image name on the Jenkins server.')
        string(name: 'APP_ENV_FILE', defaultValue: '/var/lib/jenkins/ats/app.env', description: 'Runtime env file passed into docker run.')
        string(name: 'CONTAINER_NAME_PREFIX', defaultValue: 'ats-daily', description: 'Prefix used for the transient docker container name.')
        string(name: 'SOURCE_TABLES', defaultValue: 'us_largecap,us_midcap', description: 'Comma-separated source universe tables.')
        string(name: 'MARKET_INDEX', defaultValue: '^GSPC', description: 'Representative market index ticker.')
    }

    stages {
        stage('Verify Tooling') {
            steps {
                sh 'docker --version'
                sh 'docker info >/dev/null'
            }
        }

        stage('Verify Image And Env') {
            steps {
                sh '''
                    set -euo pipefail
                    test -f "${APP_ENV_FILE}"
                    docker image inspect "${IMAGE_NAME}:latest" >/dev/null
                '''
            }
        }

        stage('Run Factor Orchestration') {
            steps {
                sh '''
                    set -euo pipefail
                    container_name="${CONTAINER_NAME_PREFIX}-${BUILD_NUMBER}"

                    docker run --rm \
                        --name "${container_name}" \
                        --env-file "${APP_ENV_FILE}" \
                        -e SOURCE_TABLES="${SOURCE_TABLES}" \
                        -e MARKET_INDEX="${MARKET_INDEX}" \
                        --entrypoint sh \
                        "${IMAGE_NAME}:latest" \
                        -c '
                            set -eu
                            old_ifs="$IFS"
                            IFS=","
                            for source_table in $SOURCE_TABLES; do
                                source_table="$(printf "%s" "$source_table" | xargs)"
                                if [ -n "$source_table" ]; then
                                    ats "$source_table" "${source_table}_metrics" "$MARKET_INDEX"
                                fi
                            done
                            IFS="$old_ifs"
                        '
                '''
            }
        }
    }

    post {
        success {
            echo "Completed daily ATS factor orchestration at 08:00 Europe/Berlin using ${params.IMAGE_NAME}:latest."
        }
    }
}
